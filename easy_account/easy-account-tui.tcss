MainScreen {
    layout: grid;
    grid-size: 2 3;
    grid-columns: auto 1fr;
    grid-rows: auto 1fr 1fr;
    grid-gutter: 1;
}

MainScreen #fetched-vals {
    layout: grid;
    grid-size: 2 3;
}

MainScreen #user-inputs {
    row-span: 2;
}

MainScreen #buttons {
    column-span: 2;
    layout: grid;
    grid-size: 3 1;
}

MainScreen #user-inputs {
    layout: grid;
    grid-size: 3 1;
}

.box {
    border: solid green;
}

.value {
    text-align: right;
}

TokenInputScreen {
    align: center middle;
}
TokenInputScreen VerticalGroup {
    width: 60;
    padding: 2;
}
TokenInputScreen #token-input {
    margin: 1 0;
}
TokenInputScreen HorizontalGroup {
    height: auto;
    width: 100%;
    align: center middle;
}
TokenInputScreen Button {
    margin: 1 1;
}
TokenInputScreen #error-msg {
    color: $error;
    margin: 1 0;
}
